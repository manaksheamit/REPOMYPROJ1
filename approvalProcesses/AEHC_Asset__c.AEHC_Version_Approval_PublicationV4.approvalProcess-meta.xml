                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Approval of security architect in  uat</description>
        <entryCriteria>
            <booleanFilter>( 1  OR ( 3 AND 4 ) ) AND 2</booleanFilter>
            <criteriaItems>
                <field>AEHC_Asset__c.AEHC_Environment__c</field>
                <operation>equals</operation>
                <value>UAT</value>
            </criteriaItems>
            <criteriaItems>
                <field>AEHC_Asset__c.AEHC_Architect_Review_Done__c</field>
                <operation>equals</operation>
                <value>False</value>
            </criteriaItems>
            <criteriaItems>
                <field>AEHC_Asset__c.AEHC_Environment__c</field>
                <operation>equals</operation>
                <value>Production</value>
            </criteriaItems>
            <criteriaItems>
                <field>AEHC_Asset__c.AEHC_Is_Subscription__c</field>
                <operation>equals</operation>
                <value>True</value>
            </criteriaItems>
        </entryCriteria>
