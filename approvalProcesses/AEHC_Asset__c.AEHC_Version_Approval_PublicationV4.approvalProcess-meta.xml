                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <booleanFilter>(1 AND (2 OR (3 AND 4)))</booleanFilter>
            <criteriaItems>
                <field>AEHC_Asset__c.Approval_Status__c</field>
                <operation>equals</operation>
                <value>DDH Admin Review</value>
            </criteriaItems>
            <criteriaItems>
                <field>AEHC_Asset__c.AEHC_Is_Subscription__c</field>
