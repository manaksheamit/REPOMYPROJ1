            <criteriaItems>
                <field>AEHC_Asset__c.AEHC_Environment__c</field>
                <operation>equals</operation>
                <value>Dev</value>
            </criteriaItems>
            <criteriaItems>
                <field>AEHC_Asset__c.AEHC_Is_Subscription__c</field>
                <operation>equals</operation>
                <value>False</value>
            </criteriaItems>
            <criteriaItems>
                <field>AEHC_Asset__c.AEHC_Publication_Owner_Approved__c</field>
