<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Community_Asset__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>L2_Approved</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Approval_Status</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Asset_Owner</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>API AO for Non-Prod and Non-Graph APIs</description>
        <entryCriteria>
            <booleanFilter>(1 OR 2 OR 3) AND 4 AND 5</booleanFilter>
            <criteriaItems>
                <field>Subscription__c.AEHC_Environment_Name__c</field>
                <operation>equals</operation>
                <value>DEV</value>
            </criteriaItems>
            <criteriaItems>
                <field>Subscription__c.AEHC_Environment_Name__c</field>
                <operation>equals</operation>
                <value>QA</value>
            </criteriaItems>
            <criteriaItems>
                <field>Subscription__c.AEHC_Environment_Name__c</field>
                <operation>equals</operation>
                <value>UAT</value>
            </criteriaItems>
            <criteriaItems>
                <field>Subscription__c.AEHC_AssetType__c</field>
                <operation>notContain</operation>
                <value>graph</value>
            </criteriaItems>
            <criteriaItems>
                <field>Subscription__c.AHEC_L2_Approved__c</field>
                <operation>equals</operation>
                <value>False</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>AO Non-Prod Non-Graph</label>
        <name>AO_Non_Prod_Non_Graph</name>
        <rejectionActions>
            <action>
                <name>Update_Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>AEHC_Status_Pending_AO_Review</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>L1_Approved</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Subscriber_Business_Owner</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>SBO for All Env for Graph APIs</description>
        <entryCriteria>
            <criteriaItems>
                <field>Subscription__c.AEHC_AssetType__c</field>
                <operation>contains</operation>
                <value>graph</value>
            </criteriaItems>
            <criteriaItems>
                <field>Subscription__c.AEHC_L1_Approved__c</field>
                <operation>equals</operation>
                <value>False</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>SBO All-Env Graph</label>
        <name>SBO_All_Env_Graph</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Update_Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>L2_Approved</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Approval_Status</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Asset_Owner</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>API AO For Dev, QA for Graph</description>
        <entryCriteria>
            <booleanFilter>(1 OR 2) AND 3 AND 4</booleanFilter>
            <criteriaItems>
                <field>Subscription__c.AEHC_Environment_Name__c</field>
                <operation>equals</operation>
                <value>DEV</value>
            </criteriaItems>
            <criteriaItems>
                <field>Subscription__c.AEHC_Environment_Name__c</field>
                <operation>equals</operation>
                <value>QA</value>
            </criteriaItems>
            <criteriaItems>
                <field>Subscription__c.AEHC_AssetType__c</field>
                <operation>contains</operation>
                <value>graph</value>
            </criteriaItems>
            <criteriaItems>
                <field>Subscription__c.AHEC_L2_Approved__c</field>
                <operation>equals</operation>
                <value>False</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>AO DEV-QA Graph</label>
        <name>AO_DEV_QA_Graph</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Update_Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>AEHC_Status_Pending_SA_Review</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>L2_Approved</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Asset_Owner</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>API AO For UAT Graph</description>
        <entryCriteria>
            <criteriaItems>
                <field>Subscription__c.AEHC_Environment_Name__c</field>
                <operation>equals</operation>
                <value>UAT</value>
            </criteriaItems>
            <criteriaItems>
                <field>Subscription__c.AEHC_AssetType__c</field>
                <operation>contains</operation>
                <value>graph</value>
            </criteriaItems>
            <criteriaItems>
                <field>Subscription__c.AHEC_L2_Approved__c</field>
                <operation>equals</operation>
                <value>False</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>AO UAT Graph</label>
        <name>AO_UAT_Graph</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Update_Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>AEHC_SA_Review_Flag_TRUE</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Approval_Status</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Security_Architect</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>SA (UAT-Graph), (Prod-Non-Graph)</description>
        <entryCriteria>
            <booleanFilter>((1 AND 4) OR 2) AND 3</booleanFilter>
            <criteriaItems>
                <field>Subscription__c.AEHC_Environment_Name__c</field>
                <operation>equals</operation>
                <value>UAT</value>
            </criteriaItems>
            <criteriaItems>
                <field>Subscription__c.AEHC_Environment_Name__c</field>
                <operation>equals</operation>
                <value>PROD</value>
            </criteriaItems>
            <criteriaItems>
                <field>Subscription__c.AEHC_Security_Architect_Approved__c</field>
                <operation>equals</operation>
                <value>False</value>
            </criteriaItems>
            <criteriaItems>
                <field>Subscription__c.AEHC_AssetType__c</field>
                <operation>contains</operation>
                <value>graph</value>
            </criteriaItems>
        </entryCriteria>
        <label>SA UAT-Prod Graph-Non-Graph</label>
        <name>SA_UAT_Prod_Graph_Non_Graph</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Update_Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>Approval process for Grpah QL and Other API Assets</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Subscription__c.RecordType</field>
            <operation>equals</operation>
            <value>API Asset</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Update_Approval_Status</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Update_Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>AEHC_APIApproval</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
