<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Community_Asset__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Update_Approval_Status</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Asset_Owner</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>All API Subscription must be approved by Asset Owner</description>
        <entryCriteria>
            <criteriaItems>
                <field>Subscription__c.AEHC_Environment_Name__c</field>
                <operation>equals</operation>
                <value>DEV</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Dev Approval</label>
        <name>Dev_Approval</name>
        <rejectionActions>
            <action>
                <name>Update_Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Update_Approval_Status</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Asset_Owner</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Non Graph API in QA must be approved by Asset Owner</description>
        <entryCriteria>
            <criteriaItems>
                <field>Subscription__c.AEHC_AssetType__c</field>
                <operation>notContain</operation>
                <value>graph</value>
            </criteriaItems>
            <criteriaItems>
                <field>Subscription__c.AEHC_Environment_Name__c</field>
                <operation>equals</operation>
                <value>QA</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>QA-Not Graph API</label>
        <name>QA_Not_Graph_API</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Update_Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Update_Approval_Status</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Security_Architect</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Graph API in UAT must be approved By Security Architect</description>
        <entryCriteria>
            <criteriaItems>
                <field>Subscription__c.AEHC_AssetType__c</field>
                <operation>contains</operation>
                <value>graph</value>
            </criteriaItems>
            <criteriaItems>
                <field>Subscription__c.AEHC_Environment_Name__c</field>
                <operation>equals</operation>
                <value>UAT</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>UAT-Graph</label>
        <name>UAT_Graph</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Update_Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Update_Approval_Status</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Asset_Owner</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Non-Graph API in UAT must be approved by Asset owner.</description>
        <entryCriteria>
            <criteriaItems>
                <field>Subscription__c.AEHC_AssetType__c</field>
                <operation>notContain</operation>
                <value>graph</value>
            </criteriaItems>
            <criteriaItems>
                <field>Subscription__c.AEHC_Environment_Name__c</field>
                <operation>equals</operation>
                <value>UAT</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>UAT-Non-Graph</label>
        <name>UAT_Non_Graph</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Update_Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Update_Approval_Status</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Security_Architect</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Non-Graph API in Prod must be approved by security Architect</description>
        <entryCriteria>
            <criteriaItems>
                <field>Subscription__c.AEHC_AssetType__c</field>
                <operation>notEqual</operation>
                <value>graph</value>
            </criteriaItems>
            <criteriaItems>
                <field>Subscription__c.AEHC_Environment_Name__c</field>
                <operation>equals</operation>
                <value>PROD</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Prod-Non-Graph</label>
        <name>Prod_Non_Graph</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Update_Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Asset_Owner</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Get the record Auto Approve</description>
        <entryCriteria>
            <booleanFilter>1 AND (2 OR 3)</booleanFilter>
            <criteriaItems>
                <field>Subscription__c.AEHC_AssetType__c</field>
                <operation>contains</operation>
                <value>graph</value>
            </criteriaItems>
            <criteriaItems>
                <field>Subscription__c.AEHC_Environment_Name__c</field>
                <operation>equals</operation>
                <value>QA</value>
            </criteriaItems>
            <criteriaItems>
                <field>Subscription__c.AEHC_Environment_Name__c</field>
                <operation>equals</operation>
                <value>PROD</value>
            </criteriaItems>
        </entryCriteria>
        <label>Default</label>
        <name>Default</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <description>Approval process for Grpah QL and Other API Assets</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Subscription__c.RecordType</field>
            <operation>equals</operation>
            <value>API Asset</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Update_Approval_Status</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Update_Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>API Approval</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>